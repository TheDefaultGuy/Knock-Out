## The index used by the [member RNG_TABLE]. Is increased every time an RNG call is made.
static var table_index : int = 0

static var rng_table_seed : int = 0

## Function that returns a number from the RNG table.
static func _get_number() -> int:
	
	# If the index is the same number as the number of elements in the table,
	# then reset the index.
	if table_index == RNG_TABLE.size():
		table_index = 0
		return RNG_TABLE[table_index]
	
	# Increases the the index for the RNG table by one.
	table_index += 1
	
	#print_rich("🎲[b] Returning Random Number: [/b]", RNG_TABLE[table_index], "[b] Index: [/b]", table_index)
	FightManager.update_ui_signal.emit()
	return RNG_TABLE[table_index]

## Returns a randomly chosen element of the [param input_array].
static func choose_random_element(input_array : Array) -> Variant:
	
	var new_index : int = get_remapped_int(0, (input_array.size() - 1))
	
	return input_array[new_index]

## Returns a random float value remapped to the given [param min_value] and [param max_value]
static func get_remapped_float(min_value : float, max_value : float) -> float:
	return remap(_get_number(), 0.0, float(RNG_TABLE.max()), min_value, max_value)

## Returns a random integer value remapped to the given [param min_value] and [param max_value]
static func get_remapped_int(min_value : int, max_value : int) -> int:
	@warning_ignore("narrowing_conversion")
	return remap(_get_number(), 0, int(RNG_TABLE.max()), min_value, max_value)


